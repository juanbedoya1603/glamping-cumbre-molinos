---
import { Image } from 'astro:assets';
import habitacionDomo from '../../assets/images/habitacion-domo-vista-montanas-cama.jpg';
import interiorDomo from '../../assets/images/interior-domo-vista-montanas-globos.jpg';
import WhatsappButton from '../WhatsappButton.astro';
---

<section id="experiencia" class="bg-forest-950 px-5 py-20 sm:px-8 lg:px-16 lg:py-28">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5" data-reveal>
      <p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-gold-400">
        Tu espacio
      </p>
      <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-cream-50 sm:text-4xl">
        Tu propio espacio entre montañas.
      </h2>
      <p class="mt-4 font-sans text-base leading-relaxed text-cream-100/80 sm:text-lg">
        Un domo para ustedes dos, con vista abierta a las montañas de Dosquebradas. Una noche
        pensada para desconectarse del ruido y quedarse con lo que importa: tiempo juntos.
      </p>
      <div class="mt-8">
        <WhatsappButton section="accommodation" label="Reservar mi escapada" />
      </div>
    </div>

    <div class="lg:col-span-7">
      <div class="relative mx-auto max-w-md pb-10 pl-2 pr-10 lg:max-w-none lg:pb-14 lg:pl-4 lg:pr-16" data-reveal data-reveal-delay="1">
        <div class="group overflow-hidden rounded-3xl">
          <Image
            src={habitacionDomo}
            alt="Cama dentro de un domo con vista a las montañas de Dosquebradas"
            loading="lazy"
            widths={[480, 828, 1200]}
            sizes="(min-width: 1024px) 50vw, 90vw"
            class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
          />
        </div>
        <div class="group absolute bottom-0 right-0 w-2/5 overflow-hidden rounded-2xl ring-4 ring-forest-950 sm:w-1/3">
          <Image
            src={interiorDomo}
            alt="Interior de un domo ambientado, con vista a las montañas"
            loading="lazy"
            widths={[300, 480]}
            sizes="(min-width: 1024px) 18vw, 35vw"
            class="aspect-square w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
          />
        </div>
      </div>
    </div>
  </div>
</section>
