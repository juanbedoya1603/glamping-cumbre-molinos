---
import { Image } from 'astro:assets';
import interiorDomoTransparente from '../../assets/images/interior-domo-transparente-jacuzzi-terraza.jpg';
import habitacionRomantica from '../../assets/images/habitacion-romantica-jacuzzi-globos.jpg';
import suitePresidencial from '../../assets/images/suite-presidencial-jacuzzi-cama-romantica.jpg';
import WhatsappButton from '../WhatsappButton.astro';

interface Props {
  showCta?: boolean;
}

const { showCta = true } = Astro.props;
---

<section id="romance" class="bg-cream-50 px-5 py-20 sm:px-8 lg:px-16 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="group relative overflow-hidden rounded-3xl" data-reveal>
      <Image
        src={interiorDomoTransparente}
        alt="Interior de domo con vista hacia la terraza y la tina de agua caliente"
        loading="lazy"
        widths={[600, 1000, 1400]}
        sizes="100vw"
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      />
      <div
        class="pointer-events-none absolute inset-0"
        style="background: linear-gradient(to top, rgba(20,38,28,0.94) 0%, rgba(20,38,28,0.86) 38%, rgba(20,38,28,0.55) 62%, rgba(20,38,28,0.1) 88%, rgba(20,38,28,0) 100%);"
      >
      </div>
      <div class="relative flex min-h-[480px] flex-col justify-end p-6 sm:min-h-[420px] sm:p-10 lg:p-14">
        <div class="max-w-xl [text-shadow:0_1px_12px_rgba(20,38,28,0.5)]">
          <p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-gold-400">
            Para los dos
          </p>
          <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-cream-50 sm:text-4xl">
            Una tina de agua caliente, la montaña y nada de afán.
          </h2>
          <p class="mt-4 font-sans text-base leading-relaxed text-cream-100/90 sm:text-lg">
            Una tarde para ustedes dos: agua caliente, vista abierta y silencio. Consulta las
            opciones con tina de agua caliente disponibles para tu fecha — te confirmamos cuál aplica. También
            puedes sumar un masaje como servicio adicional.
          </p>
          {showCta && <div class="mt-7 flex flex-wrap gap-3">
            <WhatsappButton section="jacuzzi" label="Consultar opciones con tina de agua caliente" />
            <WhatsappButton section="massage" label="Preguntar por masajes" variant="outline" />
          </div>}
        </div>
      </div>
    </div>

    <div class="mt-5 grid grid-cols-2 gap-4 sm:gap-5">
      <div class="group overflow-hidden rounded-2xl" data-reveal data-reveal-delay="1">
        <Image
          src={habitacionRomantica}
          alt="Habitación con decoración romántica junto a la tina de agua caliente"
          loading="lazy"
          widths={[400, 640]}
          sizes="(min-width: 1024px) 26vw, 50vw"
          class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        />
      </div>
      <div class="group overflow-hidden rounded-2xl" data-reveal data-reveal-delay="2">
        <Image
          src={suitePresidencial}
          alt="Suite con tina de agua caliente y ambientación romántica"
          loading="lazy"
          widths={[400, 640]}
          sizes="(min-width: 1024px) 26vw, 50vw"
          class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        />
      </div>
    </div>
  </div>
</section>
