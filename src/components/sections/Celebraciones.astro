---
import { Image } from 'astro:assets';
import habitacionCorazon from '../../assets/images/habitacion-romantica-globos-cama-corazon.jpg';
import decoracionCumpleanos from '../../assets/images/decoracion-cumpleanos-cama-globos.jpg';
import decoracionTeAmo from '../../assets/images/decoracion-te-amo-cama-globos.jpg';
import WhatsappButton from '../WhatsappButton.astro';

interface Props {
  showCta?: boolean;
}

const { showCta = true } = Astro.props;

const categorias = ['Cumpleaños', 'Aniversarios', 'Sorpresas románticas'];
---

<section id="celebraciones" class="bg-sand-300/40 px-5 py-20 sm:px-8 lg:px-16 lg:py-28">
  <div class="mx-auto grid max-w-6xl grid-cols-1 items-center gap-14 lg:grid-cols-12 lg:gap-10">
    <div class="group overflow-hidden rounded-3xl lg:col-span-6 lg:order-2" data-reveal>
      <Image
        src={habitacionCorazon}
        alt="Habitación decorada con globos y un corazón sobre la cama para una sorpresa romántica"
        loading="lazy"
        widths={[480, 828, 1200]}
        sizes="(min-width: 1024px) 42vw, 90vw"
        class="aspect-[4/5] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
      />
    </div>

    <div class="lg:col-span-6 lg:order-1" data-reveal data-reveal-delay="1">
      <p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-clay-600">
        Fechas especiales
      </p>
      <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-forest-900 sm:text-4xl">
        Que la fecha se sienta especial de verdad.
      </h2>
      <p class="mt-4 font-sans text-base leading-relaxed text-ink-700 sm:text-lg">
        Cumpleaños, aniversarios o esa sorpresa que llevas tiempo planeando: cuéntanos qué estás
        celebrando y preparamos la decoración con anticipación. Hay distintas opciones de
        decoración según tu presupuesto.
      </p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {categorias.map((categoria) => (
          <li class="rounded-full bg-cream-50 px-4 py-1.5 font-sans text-sm text-forest-800">
            {categoria}
          </li>
        ))}
      </ul>

      <div class="mt-6 grid grid-cols-2 gap-3">
        <div class="group overflow-hidden rounded-xl">
          <Image
            src={decoracionCumpleanos}
            alt="Decoración de cumpleaños con globos sobre la cama"
            loading="lazy"
            widths={[300, 480]}
            sizes="(min-width: 1024px) 20vw, 45vw"
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
          />
        </div>
        <div class="group overflow-hidden rounded-xl">
          <Image
            src={decoracionTeAmo}
            alt="Decoración romántica con mensaje y globos sobre la cama"
            loading="lazy"
            widths={[300, 480]}
            sizes="(min-width: 1024px) 20vw, 45vw"
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
          />
        </div>
      </div>

      {showCta && <div class="mt-7">
        <WhatsappButton section="celebration" label="Preparar una sorpresa" />
      </div>}
    </div>
  </div>
</section>
