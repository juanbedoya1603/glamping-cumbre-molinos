---
import { site } from '../../config/site';
import WhatsappButton from '../WhatsappButton.astro';
---

<section id="ubicacion" class="bg-cream-100 px-5 py-20 sm:px-8 lg:px-16 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-6" data-reveal>
        <p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-clay-600">
          Ubicación
        </p>
        <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-forest-900 sm:text-4xl">
          {site.location.city}, {site.location.department}.
        </h2>
        <p class="mt-4 font-sans text-base leading-relaxed text-ink-700 sm:text-lg">
          Cumbre de los Molinos está en {site.location.city}, {site.location.department},
          {site.location.nearby.toLowerCase()}. Escríbenos por WhatsApp y te compartimos la
          ubicación exacta y cómo llegar.
        </p>

        <div class="mt-7">
          <WhatsappButton section="location" label="Confirmar ubicación y cómo llegar" />
        </div>
      </div>

      <div class="lg:col-span-6" data-reveal data-reveal-delay="1">
        <div class="rounded-3xl border border-sand-400/60 bg-cream-50 p-8 sm:p-10">
          <div class="flex items-start gap-4">
            <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-forest-950/5">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" class="text-forest-800" aria-hidden="true">
                <path
                  d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                ></path>
                <circle cx="12" cy="9.5" r="2.5" stroke-linecap="round" stroke-linejoin="round"></circle>
              </svg>
            </div>
            <div>
              <p class="font-serif text-lg text-forest-900">{site.brandName}</p>
              <p class="mt-1 font-sans text-sm leading-relaxed text-ink-700">
                {site.location.city}, {site.location.department}<br />
                {site.location.country} · {site.location.nearby}
              </p>
            </div>
          </div>

          {site.location.mapUrl ? (
            <a
              href={site.location.mapUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex items-center gap-2 font-sans text-sm font-semibold text-forest-800 underline decoration-forest-800/40 underline-offset-4 transition-colors hover:text-forest-950"
            >
              Ver en Google Maps
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path>
              </svg>
            </a>
          ) : (
            <p class="mt-6 font-sans text-sm leading-relaxed text-ink-700/80">
              Aún no tenemos publicado el enlace de Google Maps — escríbenos y te enviamos la
              ubicación exacta junto con las indicaciones para llegar.
            </p>
          )}
        </div>
      </div>
    </div>
  </div>
</section>
