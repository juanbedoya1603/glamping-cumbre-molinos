---
import { Image } from 'astro:assets';
import atardecer from '../../assets/images/atardecer-domo-azul-piscina.jpg';
import piscina from '../../assets/images/piscina-natural-vista-verde-glamping.jpg';
import terrazaJacuzzi from '../../assets/images/terraza-jacuzzi-domo-azul-vista-verde.jpg';
import WhatsappButton from '../WhatsappButton.astro';
---

<section id="bienvenida" class="bg-cream-50 px-5 py-20 sm:px-8 lg:px-16 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl" data-reveal>
      <p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-clay-600">
        Lo que vas a encontrar
      </p>
      <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-forest-900 sm:text-4xl">
        Así es, sin filtros.
      </h2>
      <p class="mt-4 font-sans text-base leading-relaxed text-ink-700 sm:text-lg">
        Domos, piscina al aire libre y una terraza con jacuzzi en medio del verde de Dosquebradas.
        Así se ve Cumbre de los Molinos en la vida real — no en un render.
      </p>
    </div>

    <div class="mt-10 grid grid-cols-1 gap-4 lg:grid-cols-12 lg:gap-5">
      <div class="group overflow-hidden rounded-3xl lg:col-span-7" data-reveal>
        <Image
          src={atardecer}
          alt="Atardecer junto al domo azul y la piscina del glamping"
          loading="lazy"
          widths={[480, 828, 1200]}
          sizes="(min-width: 1024px) 58vw, 100vw"
          class="aspect-[4/3] h-full w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105 lg:aspect-auto"
        />
      </div>

      <div class="grid grid-cols-2 gap-4 lg:col-span-5 lg:grid-cols-1 lg:gap-5">
        <div class="group overflow-hidden rounded-3xl" data-reveal data-reveal-delay="1">
          <Image
            src={piscina}
            alt="Piscina al aire libre rodeada de vegetación en el glamping"
            loading="lazy"
            widths={[400, 640]}
            sizes="(min-width: 1024px) 26vw, 50vw"
            class="aspect-square w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
          />
        </div>
        <div class="group overflow-hidden rounded-3xl" data-reveal data-reveal-delay="2">
          <Image
            src={terrazaJacuzzi}
            alt="Terraza con jacuzzi y vista verde junto al domo azul"
            loading="lazy"
            widths={[400, 640]}
            sizes="(min-width: 1024px) 26vw, 50vw"
            class="aspect-square w-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
          />
        </div>
      </div>
    </div>

    <div class="mt-10" data-reveal>
      <WhatsappButton section="accommodation" label="Ver disponibilidad" variant="ghost" />
    </div>
  </div>
</section>
