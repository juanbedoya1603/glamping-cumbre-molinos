---
import WhatsappButton from '../WhatsappButton.astro';

const alojamientos = [
  {
    nombre: 'Cabaña',
    descripcion: 'Acogedora y rodeada de naturaleza.',
    semana: '$245.000',
    finDeSemana: '$300.000',
    etiqueta: null,
  },
  {
    nombre: 'Domo Standard',
    descripcion: 'La experiencia glamping para desconectarse en pareja.',
    semana: '$270.000',
    finDeSemana: '$350.000',
    etiqueta: null,
  },
  {
    nombre: 'Domo Presidencial',
    descripcion: 'Más espacio, madera y mayor confort.',
    semana: '$300.000',
    finDeSemana: '$350.000',
    etiqueta: 'Mayor confort',
  },
] as const;

const incluidos = [
  '2 desayunos',
  'Tina de agua caliente',
  'Baño privado',
  'WiFi',
  'Parqueadero',
] as const;

const extras = [
  { nombre: 'Decoraciones', precio: 'desde $40.000' },
  { nombre: 'Cabalgata', precio: '$60.000 / persona' },
  { nombre: 'Masaje relajante', precio: '$80.000 / persona' },
  { nombre: 'Cuatrimoto', precio: 'desde $40.000' },
] as const;
---

<section id="tarifas" class="bg-cream-100 px-5 py-20 sm:px-8 lg:px-16 lg:py-28">
  <div class="mx-auto max-w-6xl">
    <div class="max-w-2xl" data-reveal>
      <p class="font-sans text-xs font-semibold uppercase tracking-[0.2em] text-clay-600">
        Tarifas
      </p>
      <h2 class="mt-3 font-serif text-3xl font-semibold leading-tight text-forest-900 sm:text-4xl">
        Elige tu forma de desconectarte.
      </h2>
      <p class="mt-4 font-sans text-base leading-relaxed text-ink-700 sm:text-lg">
        Una noche para dos, desayuno incluido y todo listo para disfrutar la montaña.
      </p>
    </div>

    <div
      class="mt-10 overflow-hidden rounded-3xl bg-cream-50 ring-1 ring-sand-400/55"
      data-reveal
      data-reveal-delay="1"
    >
      <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.08fr_1.16fr]">
        {alojamientos.map((alojamiento, index) => (
          <article
            class:list={[
              'relative px-5 py-6 sm:px-7 sm:py-7 lg:px-8 lg:py-9',
              index > 0 && 'border-t border-sand-400/55 lg:border-l lg:border-t-0',
              alojamiento.etiqueta && 'bg-sand-300/35',
            ]}
          >
            <div class="flex min-h-14 items-start justify-between gap-4">
              <h3 class="font-serif text-2xl font-semibold leading-tight text-forest-900">
                {alojamiento.nombre}
              </h3>
              {alojamiento.etiqueta && (
                <span class="shrink-0 rounded-full bg-forest-900 px-3 py-1 font-sans text-[11px] font-semibold text-cream-50">
                  {alojamiento.etiqueta}
                </span>
              )}
            </div>

            <p class="mt-2 min-h-10 font-sans text-sm leading-relaxed text-ink-700">
              {alojamiento.descripcion}
            </p>

            <dl class="mt-6 grid grid-cols-2 gap-3 border-t border-sand-400/55 pt-5">
              <div>
                <dt class="font-sans text-[11px] font-semibold uppercase tracking-[0.12em] text-clay-600">
                  Entre semana
                </dt>
                <dd class="mt-1 font-serif text-[1.65rem] font-semibold leading-none tracking-tight text-forest-900 sm:text-3xl">
                  {alojamiento.semana}
                </dd>
              </div>
              <div class="border-l border-sand-400/55 pl-3 sm:pl-4">
                <dt class="font-sans text-[11px] font-semibold uppercase tracking-[0.12em] text-clay-600">
                  Fin de semana
                </dt>
                <dd class="mt-1 font-serif text-[1.65rem] font-semibold leading-none tracking-tight text-forest-900 sm:text-3xl">
                  {alojamiento.finDeSemana}
                </dd>
              </div>
            </dl>
          </article>
        ))}
      </div>

      <div class="border-t border-sand-400/55 bg-forest-900 px-5 py-6 sm:px-7 lg:px-8">
        <p class="font-serif text-lg font-semibold text-cream-50">Incluido en tu estadía</p>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label="Servicios incluidos">
          {incluidos.map((incluido) => (
            <li class="rounded-full border border-cream-100/20 bg-cream-50/10 px-3.5 py-2 font-sans text-sm text-cream-50">
              {incluido}
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div
      class="mt-5 rounded-3xl border border-sand-400/60 bg-sand-300/30 px-5 py-6 sm:px-7 lg:flex lg:items-center lg:gap-10 lg:px-8"
      data-reveal
      data-reveal-delay="2"
    >
      <p class="shrink-0 font-serif text-lg font-semibold text-forest-900">
        También puedes sumar a tu experiencia
      </p>
      <dl class="mt-4 grid flex-1 grid-cols-1 gap-x-8 gap-y-3 sm:grid-cols-2 lg:mt-0">
        {extras.map((extra) => (
          <div class="flex items-baseline justify-between gap-4 font-sans text-sm">
            <dt class="text-ink-700">{extra.nombre}</dt>
            <dd class="shrink-0 font-semibold text-forest-900">{extra.precio}</dd>
          </div>
        ))}
      </dl>
    </div>

    <div class="mt-8" data-reveal data-reveal-delay="3">
      <WhatsappButton section="rates" label="Consultar disponibilidad" />
      <p class="mt-4 max-w-2xl font-sans text-xs leading-relaxed text-ink-700/75">
        *Tarifas por pareja. Los precios pueden variar según temporada, festivos, fechas especiales y disponibilidad.
      </p>
    </div>
  </div>
</section>
