---
import { site } from '../config/site';

interface Props {
  showCta?: boolean;
}

const { showCta = true } = Astro.props;
---

<footer class="bg-forest-950 px-5 py-12 text-cream-100 sm:px-8">
  <div class="mx-auto flex max-w-6xl flex-col items-center gap-5 text-center">
    <img src="/logo.png" alt={site.brandName} width="56" height="56" class="h-14 w-14 rounded-full object-cover" />
    <div>
      <p class="font-serif text-lg font-semibold text-cream-50">{site.brandName}</p>
      <p class="mt-1 font-sans text-sm text-cream-100/70">
        {site.location.city}, {site.location.department} · {site.location.nearby}
      </p>
    </div>

    {showCta && <a
      href={`https://wa.me/${site.whatsapp.number}`}
      target="_blank"
      rel="noopener noreferrer"
      class="font-sans text-sm text-gold-400 transition-colors hover:text-gold-300"
    >
      {site.whatsapp.displayNumber}
    </a>}

    <div class="flex flex-wrap items-center justify-center gap-3 pt-1" aria-label="Redes sociales">
      {site.social.facebook && (
        <a
          href={site.social.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex min-h-[44px] items-center gap-2 rounded-full border border-cream-100/15 bg-cream-50/5 px-4 py-2 font-sans text-sm font-semibold text-cream-50 shadow-[0_14px_36px_rgba(0,0,0,0.18)] transition-[background-color,border-color,transform] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] hover:border-gold-400/45 hover:bg-cream-50/10 active:scale-[0.97]"
          aria-label="Abrir Facebook de Glamping Cumbre de los Molinos"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true" class="text-gold-400 transition-transform duration-150 group-hover:scale-110">
            <path d="M14 8.5h2.2V5.2c-.4-.1-1.7-.2-3.2-.2-3.1 0-5.2 1.9-5.2 5.4v3H4.5V17h3.3v7h4V17h3.3l.5-3.6h-3.8v-2.6c0-1 .3-2.3 2.2-2.3Z" />
          </svg>
          Facebook
        </a>
      )}

      {site.social.instagram && (
        <a
          href={site.social.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex min-h-[44px] items-center gap-2 rounded-full border border-cream-100/15 bg-cream-50/5 px-4 py-2 font-sans text-sm font-semibold text-cream-50 shadow-[0_14px_36px_rgba(0,0,0,0.18)] transition-[background-color,border-color,transform] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] hover:border-gold-400/45 hover:bg-cream-50/10 active:scale-[0.97]"
          aria-label="Abrir Instagram de Glamping Cumbre de los Molinos"
        >
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="text-gold-400 transition-transform duration-150 group-hover:scale-110">
            <rect x="4.5" y="4.5" width="15" height="15" rx="4.2"></rect>
            <circle cx="12" cy="12" r="3.4"></circle>
            <path d="M16.9 7.2h.01" stroke-linecap="round"></path>
          </svg>
          Instagram
        </a>
      )}
    </div>

    <p class="mt-4 font-sans text-xs text-cream-100/40">
      © {new Date().getFullYear()} {site.brandName}. Todos los derechos reservados.
      {site.rnt && <> · RNT {site.rnt}</>}
    </p>
  </div>
</footer>
