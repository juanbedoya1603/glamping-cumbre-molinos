---
import { buildWhatsappUrl } from '../lib/whatsapp';

interface Props {
  showCta?: boolean;
}

const { showCta = true } = Astro.props;

const links = [
  { href: '#experiencia', label: 'Experiencia' },
  { href: '#celebraciones', label: 'Celebraciones' },
  { href: '#actividades', label: 'Actividades' },
  { href: '#ubicacion', label: 'Ubicación' },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-40 transition-colors duration-300" data-header>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6 lg:px-8">
    <a href="#top" class="flex items-center gap-2">
      <img src="/logo.png" alt="Glamping Cumbre de los Molinos" width="40" height="40" class="h-9 w-9 rounded-full object-cover sm:h-10 sm:w-10" />
      <span class="font-serif text-sm font-semibold tracking-wide text-cream-50 sm:text-base" data-header-text>
        Cumbre de los Molinos
      </span>
    </a>

    <nav class="hidden items-center gap-7 md:flex">
      {links.map((link) => (
        <a
          href={link.href}
          class="group relative font-sans text-sm font-medium text-cream-50/90 transition-colors duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] hover:text-gold-400"
          data-header-text
        >
          {link.label}
          <span class="absolute -bottom-1 left-0 h-px w-full origin-left scale-x-0 bg-gold-400 transition-transform duration-200 ease-[cubic-bezier(0.23,1,0.32,1)] group-hover:scale-x-100" aria-hidden="true"></span>
        </a>
      ))}
    </nav>

    {showCta && <a
      href={buildWhatsappUrl('hero')}
      target="_blank"
      rel="noopener noreferrer"
      data-whatsapp-cta
      data-section="header"
      class="hidden items-center gap-2 rounded-full bg-gold-500 px-4 py-2 text-sm font-semibold text-forest-950 transition-[transform,background-color] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] hover:bg-gold-400 active:scale-[0.97] md:inline-flex"
    >
      Consultar disponibilidad
    </a>}

    <button
      type="button"
      class="inline-flex h-10 w-10 items-center justify-center rounded-full text-cream-50 transition-[transform,background-color] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] hover:bg-cream-50/10 active:scale-[0.93] md:hidden"
      data-mobile-menu-toggle
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Abrir menú"
    >
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div
    class="max-h-0 overflow-hidden bg-forest-950 transition-[max-height] duration-300 ease-[cubic-bezier(0.77,0,0.175,1)] md:hidden"
    data-mobile-menu-wrapper
  >
    <div id="mobile-menu" class="flex flex-col gap-1 px-4 pb-6 pt-2" data-mobile-menu>
      {links.map((link) => (
        <a
          href={link.href}
          class="rounded-lg px-3 py-3 font-sans text-base text-cream-50 transition-[background-color,transform] duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] hover:bg-cream-50/10 active:scale-[0.98]"
          data-mobile-link
        >
          {link.label}
        </a>
      ))}
      {showCta && <a
        href={buildWhatsappUrl('hero')}
        target="_blank"
        rel="noopener noreferrer"
        data-whatsapp-cta
        data-section="header_mobile"
        class="mt-2 inline-flex items-center justify-center gap-2 rounded-full bg-gold-500 px-4 py-3 text-sm font-semibold text-forest-950 transition-transform duration-150 ease-[cubic-bezier(0.23,1,0.32,1)] active:scale-[0.97]"
      >
        Consultar disponibilidad
      </a>}
    </div>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-mobile-menu-toggle]');
  const menuWrapper = document.querySelector<HTMLElement>('[data-mobile-menu-wrapper]');

  const applyScrollState = () => {
    if (!header) return;
    const solid = window.scrollY > 48;
    header.classList.toggle('bg-forest-950/95', solid);
    header.classList.toggle('backdrop-blur-sm', solid);
    header.classList.toggle('shadow-sm', solid);
  };

  applyScrollState();
  window.addEventListener('scroll', applyScrollState, { passive: true });

  let menuOpen = false;

  const setMenuOpen = (open: boolean) => {
    menuOpen = open;
    if (menuWrapper) {
      menuWrapper.style.maxHeight = open ? `${menuWrapper.scrollHeight}px` : '0px';
    }
    toggle?.setAttribute('aria-expanded', String(open));
  };

  toggle?.addEventListener('click', () => setMenuOpen(!menuOpen));

  menuWrapper?.querySelectorAll('[data-mobile-link]').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });
</script>
